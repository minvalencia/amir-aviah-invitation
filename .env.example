# Copy this file to .env (for local dev) and set the same values
# in Render's "Environment" tab for production.

# Admin login credentials (REQUIRED — change these!)
ADMIN_USER=parent
ADMIN_PASS=change_this_to_a_strong_password

# Hidden URL slug for the admin dashboard.
# The dashboard will live at https://your-app.onrender.com/<ADMIN_PATH>
# Make this long and random — it acts as your "secret link".
ADMIN_PATH=admin-secret-rsvp-2026

# Optional: where to store the SQLite DB.
# - Local: ./data/rsvps.db (default)
# - Render with persistent disk mounted at /data: /data/rsvps.db
DB_PATH=./data/rsvps.db

# Port (Render sets this automatically; only needed locally)
PORT=3000
